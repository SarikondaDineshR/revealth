# App
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://revealth:revealth@127.0.0.1:5433/revealth?schema=public
DIRECT_DATABASE_URL=postgresql://revealth:revealth@127.0.0.1:5433/revealth?schema=public

# Auth
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001
LOCAL_OWNER_EMAIL=founder@revealth.local
NEXT_PUBLIC_API_URL=http://localhost:4000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=revealth-v01

# Model Providers
MODEL_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_PLANNING_MODEL=gpt-4.1-mini
DEFAULT_REVIEW_MODEL=claude-3-5-sonnet-latest

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_REPOSITORY=
GITHUB_ISSUE_CREATION_MODE=dry_run
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Security
ENCRYPTION_KEY=replace-with-32-byte-base64-key
COOKIE_SECRET=replace-with-long-random-cookie-secret

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=revealth-api
