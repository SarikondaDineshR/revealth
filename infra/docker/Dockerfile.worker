FROM node:20-slim AS base
RUN apt-get update -y && apt-get install -y openssl
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/workers/package.json apps/workers/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/model-providers/package.json packages/model-providers/package.json

COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm exec prisma generate --schema packages/database/prisma/schema.prisma
RUN pnpm --filter @revealth/workers... build

CMD ["pnpm", "--filter", "@revealth/workers", "start"]
