{
  "name": "revealth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel -r dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "corepack pnpm --filter @revealth/database db:generate",
    "db:migrate": "corepack pnpm --filter @revealth/database db:migrate",
    "db:deploy": "corepack pnpm --filter @revealth/database db:deploy",
    "db:seed": "corepack pnpm --filter @revealth/database db:seed",
    "docker:up": "docker compose up -d postgres temporal temporal-ui",
    "docker:down": "docker compose down",
    "demo:doctor": "powershell -ExecutionPolicy Bypass -File scripts/demo-doctor.ps1",
    "demo:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/demo-bootstrap.ps1",
    "demo:smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.17.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
